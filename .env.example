# Development and staging files should be named .env.development or .env.staging.
# Production secrets must be configured in the deployment secret manager, not committed.

# Server-side AI access
GEMINI_API_KEY="REQUIRED_IN_DEPLOYMENT"
# Stable text model used by production AI routes.
GEMINI_TEXT_MODEL="gemini-3.7-flash"
# Keep false in production; true is only for local offline demos.
AI_ALLOW_FALLBACK="false"
AI_REQUIRE_AUTH="true"

# Server-side Supabase values used to validate bearer tokens.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Public web-client Supabase values. These are still deployment configuration, not source code.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Payment provider values. Configure these only in the deployment secret manager.
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="REQUIRED_IN_DEPLOYMENT"
STRIPE_WEBHOOK_SECRET="REQUIRED_IN_DEPLOYMENT"
STRIPE_PRICE_PREMIUM="REQUIRED_IN_DEPLOYMENT"
STRIPE_PRICE_PROFESSIONAL="REQUIRED_IN_DEPLOYMENT"
# Required only by the trusted billing webhook process; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="REQUIRED_IN_DEPLOYMENT"
APP_URL="https://YOUR_DEPLOYED_APP_URL"
